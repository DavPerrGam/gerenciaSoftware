import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import type { FormEvent } from 'react';
import { Lock } from 'lucide-react';

import { Header } from '../components/Header';
import { authService } from '../services/auth.service.js';

export function LoginPage() {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const navigate = useNavigate();

  const handleLogin = (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    setError('');
    setIsLoading(true);

    const loginSuccess = authService.login(email, password);

    if (loginSuccess) {
      navigate('/admin');
    } else {
      setError('Email o contraseña incorrectos');
      setIsLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-brand-soft flex flex-col">
      <Header />
      <main className="flex-1 flex items-center justify-center px-4 py-12">
        <div className="w-full max-w-lg">
          <div className="surface-card p-10 border border-slate-200 shadow-lg shadow-slate-950/5">
            <div className="text-center mb-8">
              <div className="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-full bg-brand text-white shadow-brand">
                <Lock size={28} />
              </div>
              <h2 className="mt-5 text-3xl font-semibold text-slate-950">Acceso administrativo</h2>
              <p className="mt-3 text-sm text-muted">Ingresa para revisar el estado de servicios y eventos hospitalarios.</p>
            </div>

            {error && (
              <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-3xl mb-6 text-sm">
                {error}
              </div>
            )}

            <form onSubmit={handleLogin} className="space-y-5">
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-2">Email</label>
                <input
                  type="email"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  disabled={isLoading}
                  className="input-field focus-ring"
                  placeholder="admin@sanrafael.gov.co"
                  required
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-slate-700 mb-2">Contraseña</label>
                <input
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  disabled={isLoading}
                  className="input-field focus-ring"
                  required
                />
              </div>

              <button
                type="submit"
                disabled={isLoading}
                className="button-primary w-full disabled:bg-slate-300 disabled:text-slate-600"
              >
                {isLoading ? 'Iniciando...' : 'Iniciar sesión'}
              </button>
            </form>

            <div className="mt-8 rounded-3xl border border-slate-200 bg-slate-50 p-5 text-sm text-muted">
              <p className="font-semibold text-slate-900 mb-2">Credenciales de demostración</p>
              <p className="font-mono text-xs">usuario: admin@sanrafael.gov.co</p>
              <p className="font-mono text-xs">clave: SanRafael2026*</p>
            </div>
          </div>
        </div>
      </main>
    </div>
  );
}
